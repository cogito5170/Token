{
 "schema": "gc-visual-encoding/1",
 "owner": "design",
 "note": "Visual language of the live monitor (docs/ui-design.md 6, design/motion.md). One entry per signal: every L0 kind (ga 0.6 emitted + l0-telemetry catalog, scripts/check_docs.py L0_KINDS) and every file/derived signal of docs/visualization.md screen live_monitor. Signal names are the MonitorEvent kind (docs/data-model.md 7.2). duration names a key of durations_ms. Stage text is only one word from words. Numbers only in hover.",
 "words": [
  "build",
  "wait",
  "talk",
  "test",
  "done"
 ],
 "words_reserved": {
  "test": "reserved until ga emits check events (reports/CMD-GC0.md); no signal shows it yet"
 },
 "word_style": {
  "case": "lower",
  "font": "mono",
  "size_px": 12,
  "max_on_stage_ms": 2000,
  "sticky_while_true": [
   "derived:stall",
   "derived:all_done"
  ],
  "max_per_figure": 1,
  "emoji": false
 },
 "glossary_banned_on_stage": [
  "node",
  "queue",
  "token",
  "tokens",
  "pi",
  "L0",
  "agent",
  "LLM",
  "API",
  "session",
  "item",
  "turn",
  "role",
  "peer",
  "pool",
  "budget",
  "cost",
  "model",
  "prompt",
  "cache",
  "json",
  "telemetry",
  "sidecar"
 ],
 "durations_ms": {
  "instant": 0,
  "fast": 120,
  "base": 200,
  "slow": 400,
  "travel": 800,
  "breath": 4000
 },
 "reduced_motion": {
  "rule": "no travel, no breathing, no orbit, no particles, no sweeps; state changes swap shapes instantly; only opacity fades <= 120 ms",
  "max_fade_ms": 120,
  "highlight_hold_ms": 1000,
  "forbidden_terms": [
   "travel",
   "breath",
   "orbit",
   "particle",
   "sweep",
   "expand",
   "drift",
   "fly",
   "flies",
   "float",
   "tremble",
   "spin"
  ]
 },
 "stage": {
  "theme": "dark",
  "bands": [
   {
    "name": "waiting_shelf",
    "place": "top",
    "holds": "tiles waiting to be picked"
   },
   {
    "name": "stage",
    "place": "middle",
    "holds": "figures, lines, pulses, rings, fuel arcs"
   },
   {
    "name": "done_shelf",
    "place": "bottom",
    "holds": "filled tiles that are finished"
   },
   {
    "name": "failed_shelf",
    "place": "right",
    "holds": "split tiles that failed"
   },
   {
    "name": "rest_rim",
    "place": "border",
    "holds": "retired figures and their outcome dots"
   },
   {
    "name": "horizon",
    "place": "behind the done shelf",
    "holds": "total use vs budget as a line height"
   }
  ],
  "scroll": false,
  "rescale": true,
  "max_figures_legible": 12
 },
 "figures": {
  "shape_by": "index of the role in pool.json roles (MonitorSnapshot figures[].shape_index)",
  "shapes": [
   "circle",
   "rounded_square",
   "hexagon",
   "triangle",
   "diamond",
   "pill"
  ],
  "beyond_six": "shape = shapes[i % 6]; each further cycle adds one inner notch (i // 6 notches), never a new color",
  "size": "area ~ sqrt(tokens of the current item); min 24 px, max 72 px diameter",
  "states": {
   "running": {
    "lightness_pct": 100,
    "outline": "solid",
    "halo": "breathing, tempo rises with elapsed",
    "inner": "particles",
    "word": "build"
   },
   "continuing": {
    "lightness_pct": 100,
    "outline": "solid",
    "halo": "breathing",
    "inner": "orbiting dot",
    "word": "build"
   },
   "waiting_peer": {
    "lightness_pct": 60,
    "outline": "solid",
    "halo": "small",
    "inner": "none",
    "tether": "taut line to the awaited figure",
    "word": "wait"
   },
   "idle": {
    "lightness_pct": 40,
    "outline": "solid",
    "halo": "small, slow breath",
    "inner": "none",
    "word": "wait"
   },
   "retiring": {
    "lightness_pct": 40,
    "outline": "thin",
    "halo": "none",
    "inner": "none",
    "word": null
   },
   "retired": {
    "lightness_pct": 30,
    "outline": "none",
    "halo": "none",
    "inner": "outcome dot on the rest rim",
    "word": null
   }
  },
  "rings": {
   "verified": {
    "shape": "closed",
    "word": "done"
   },
   "failed": {
    "shape": "jagged_gap",
    "word": null
   },
   "needs_judgement": {
    "shape": "open_gap",
    "word": null
   },
   "budget": {
    "shape": "flat_cap",
    "word": null
   },
   "none": {
    "shape": "absent",
    "word": null
   }
  },
  "retired_outcome_marks": {
   "done": "solid_dot",
   "failed": "broken_outline_dot",
   "idle": "no_mark"
  },
  "fuel_arc": "arc length = this figure's tokens / largest figure's tokens; tick marks appear under tension",
  "edge_weight_px": {
   "min": 1,
   "max": 6,
   "from": "pi (pi_permille 0..1000 -> 1..6 px, rounded)"
  },
  "edge_distance": "higher pi pulls two figures closer (layout spring)"
 },
 "tiles": {
  "shelves": {
   "waiting": "waiting_shelf",
   "held": "in the holder figure's hands",
   "done": "done_shelf",
   "failed": "failed_shelf"
  },
  "shapes": {
   "waiting": "outlined",
   "held": "outlined, attached",
   "done": "filled",
   "failed": "split in two",
   "dropped": "dotted outline for 1 s"
  },
  "child_link": "thin line from a child tile to its parent tile"
 },
 "moods": {
  "priority": [
   "all_done",
   "stall",
   "tension",
   "collaboration",
   "pace"
  ],
  "combine": "pace always sets the base tempo; collaboration and tension multiply it; stall overrides tempo and lightness; all_done ends everything else",
  "rules": {
   "pace": {
    "when": "events per minute over all sources",
    "tempo_x": "0.5 + min(events_per_min, 30) / 20",
    "lightness_delta_pct": 0,
    "word": null
   },
   "collaboration": {
    "when": "peer messages per minute >= 3",
    "tempo_x": 1.0,
    "layout": "springs tighten 20 %",
    "pulses": "phase-locked to one shared beat",
    "lightness_delta_pct": 10,
    "word": null
   },
   "tension": {
    "when": "budget use >= 80 %, or >= 2 failed tiles, or a waiting chain >= 3",
    "tempo_x": 1.5,
    "rim": "warm horizon light (the only use of warm)",
    "marks": "tick marks on fuel arcs",
    "lightness_delta_pct": 0,
    "word": null
   },
   "stall": {
    "when": "no signal for 120 s while tiles wait or figures are live",
    "tempo_x": 0.3,
    "lightness_delta_pct": -20,
    "word": "wait"
   },
   "all_done": {
    "when": "queue empty, nothing live, >= 1 tile done",
    "tempo_x": 0.0,
    "layout": "figures settle in one line",
    "sweep": "one calm sweep, then still",
    "lightness_delta_pct": 0,
    "word": "done"
   }
  },
  "hue": {
   "accent": "blue (one per screen)",
   "warm": "orange, tension only"
  }
 },
 "limits": {
  "fps_max": 60,
  "particles_max": 400,
  "pulses_merge_above": 20
 },
 "signals": [
  {
   "signal": "l0:node.started",
   "source": "L0 .ga/pool/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "figure emerges at the edge of the stage and takes its place",
   "motion": "scale 0->1 (slow), then settles into the layout",
   "duration": "slow",
   "reduced_motion": "appears at full size, fades in 120 ms",
   "not_color_only": "shape appears (presence), not a color change",
   "word": null,
   "hover": "role, item id"
  },
  {
   "signal": "l0:node.retired",
   "source": "L0 .ga/pool/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "figure leaves for the rest rim; outcome done leaves a solid dot, failed a broken-outline dot, idle fades without a mark",
   "motion": "shrink + drift to rim (slow)",
   "duration": "slow",
   "reduced_motion": "jumps to rim, outline style shows outcome",
   "not_color_only": "outcome told by mark shape: solid dot / broken outline / no mark",
   "word": "done",
   "hover": "outcome, turns, tokens"
  },
  {
   "signal": "l0:work.accepted",
   "source": "L0 .ga/pool/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "a small child tile buds off the proposer's tile and joins the waiting shelf",
   "motion": "bud splits off (base), floats up to the shelf",
   "duration": "base",
   "reduced_motion": "child tile appears on the shelf",
   "not_color_only": "new tile shape with a thin link to its parent tile",
   "word": null,
   "hover": "child id, reason"
  },
  {
   "signal": "l0:work.dropped",
   "source": "L0 .ga/pool/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "a bud appears and dissolves, leaving a dotted outline for a moment",
   "motion": "bud forms then dissolves (slow)",
   "duration": "slow",
   "reduced_motion": "dotted outline shown 1 s, no motion",
   "not_color_only": "dotted outline (shape), not color",
   "word": null,
   "hover": "reason"
  },
  {
   "signal": "l0:work.failed",
   "source": "L0 .ga/pool/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "the tile cracks in two and slides to the side shelf",
   "motion": "crack + slide (base)",
   "duration": "base",
   "reduced_motion": "tile shown split on the side shelf",
   "not_color_only": "split shape + position on side shelf",
   "word": null,
   "hover": "reason"
  },
  {
   "signal": "l0:run.end",
   "source": "L0 .ga/nodes/<n>/telemetry.jsonl, .ga/telemetry/<s>.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "the figure exhales: one ring expands from it; the figure grows a step (area ~ sqrt(tokens of this item)); its fuel arc advances",
   "motion": "ring expands and fades (slow); size eases (base)",
   "duration": "slow",
   "reduced_motion": "ring drawn once at final size, no expansion; size changes instantly",
   "not_color_only": "ring + size + arc length, all lightness-independent",
   "word": null,
   "hover": "model, turns, tokens in/out/cache, cost (CLI), duration"
  },
  {
   "signal": "l0:peer.message.sent",
   "source": "L0 .ga/nodes/<n>/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "edge",
   "visual": "a pulse of light travels along the curve from sender to receiver; pulse size ~ log(bytes); line weight = pi",
   "motion": "travel along the edge (~800 ms, eased)",
   "duration": "travel",
   "reduced_motion": "edge drawn thicker for 1 s, pulse not shown",
   "not_color_only": "pulse is a moving shape; edge weight, not color, carries pi",
   "word": "talk",
   "hover": "schema, bytes, tokens_est (estimated)"
  },
  {
   "signal": "l0:peer.message.received",
   "source": "L0 .ga/nodes/<n>/telemetry.jsonl",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "the receiver absorbs the pulse: a short ring flash on its outline",
   "motion": "ring flash (fast)",
   "duration": "fast",
   "reduced_motion": "outline thickens 1 s",
   "not_color_only": "outline thickness",
   "word": null,
   "hover": "from, msg id"
  },
  {
   "signal": "l0:turn.start",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure starts its working glow (build)",
   "motion": "breathing glow whose tempo rises with elapsed time",
   "duration": "breath",
   "reduced_motion": "steady glow + small elapsed tick marks",
   "not_color_only": "glow halo + tick marks",
   "word": "build",
   "hover": "elapsed"
  },
  {
   "signal": "l0:turn.end",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "same exhale ring as run.end",
   "motion": "ring expands",
   "duration": "slow",
   "reduced_motion": "ring once",
   "not_color_only": "ring shape",
   "word": null
  },
  {
   "signal": "l0:turn.continued",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "a small dot orbits the figure (the work goes on)",
   "motion": "orbit (slow)",
   "duration": "breath",
   "reduced_motion": "static dot at 12 o'clock",
   "not_color_only": "orbiting dot shape",
   "word": "build"
  },
  {
   "signal": "l0:run.start",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure starts its working glow",
   "motion": "breathing glow",
   "duration": "breath",
   "reduced_motion": "steady glow",
   "not_color_only": "glow halo",
   "word": "build"
  },
  {
   "signal": "l0:run.snapshot",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "meter",
   "visual": "fuel arcs update",
   "motion": "arc eases",
   "duration": "base",
   "reduced_motion": "arc jumps",
   "not_color_only": "arc length",
   "word": null,
   "hover": "cost so far"
  },
  {
   "signal": "l0:llm.request",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure inhales: glow brightens briefly",
   "motion": "brighten (fast)",
   "duration": "fast",
   "reduced_motion": "halo grows one step for 1 s, no pulse",
   "not_color_only": "halo size (paired with the response ring)",
   "word": null
  },
  {
   "signal": "l0:llm.response",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "small exhale ring and fuel arc advance",
   "motion": "ring (base)",
   "duration": "base",
   "reduced_motion": "arc jumps",
   "not_color_only": "ring + arc length",
   "word": null,
   "hover": "tokens"
  },
  {
   "signal": "l0:llm.error",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure outline flickers jagged once",
   "motion": "jagged flicker (fast)",
   "duration": "fast",
   "reduced_motion": "jagged outline 1 s",
   "not_color_only": "jagged outline shape",
   "word": null,
   "hover": "error class"
  },
  {
   "signal": "l0:tool.start",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "a spark leaves the figure to its tool orbit",
   "motion": "spark travels out (fast)",
   "duration": "fast",
   "reduced_motion": "spark mark shown still on the tool ring",
   "not_color_only": "spark shape",
   "word": "build",
   "hover": "tool head (hashed target)"
  },
  {
   "signal": "l0:tool.end",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "the spark returns into the figure",
   "motion": "spark travels back",
   "duration": "fast",
   "reduced_motion": "spark removed",
   "not_color_only": "spark shape",
   "word": null
  },
  {
   "signal": "l0:input.received",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "a small dot drops into the figure from above",
   "motion": "drop (fast)",
   "duration": "fast",
   "reduced_motion": "dot appears inside",
   "not_color_only": "dot shape",
   "word": null
  },
  {
   "signal": "l0:input.removed",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "a dot leaves the figure and fades",
   "motion": "rise + fade",
   "duration": "base",
   "reduced_motion": "dot removed",
   "not_color_only": "dot shape",
   "word": null
  },
  {
   "signal": "l0:provider.rate_limit",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure outline turns dashed and its glow pauses",
   "motion": "breathing stops",
   "duration": "base",
   "reduced_motion": "dashed outline",
   "not_color_only": "dashed outline",
   "word": "wait",
   "hover": "retry after"
  },
  {
   "signal": "l0:provider.rate_limit_window",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "same as provider.rate_limit while the window lasts",
   "motion": "breathing stops",
   "duration": "base",
   "reduced_motion": "dashed outline",
   "not_color_only": "dashed outline",
   "word": "wait"
  },
  {
   "signal": "l0:runtime.compaction",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "figure squeezes briefly (its memory was compacted)",
   "motion": "squeeze and release (base)",
   "duration": "base",
   "reduced_motion": "figure outline doubles for 1 s",
   "not_color_only": "double outline",
   "word": null,
   "hover": "tokens before/after"
  },
  {
   "signal": "l0:action.dispatch",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "a spark leaves toward the stage edge (an action goes out)",
   "motion": "travel out",
   "duration": "base",
   "reduced_motion": "spark at edge",
   "not_color_only": "spark shape",
   "word": null
  },
  {
   "signal": "l0:action.result",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "figure",
   "visual": "the spark returns: solid if ok, jagged if error",
   "motion": "travel back",
   "duration": "base",
   "reduced_motion": "solid or jagged mark 1 s",
   "not_color_only": "solid vs jagged shape",
   "word": null
  },
  {
   "signal": "l0:runtime.limits",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "none",
   "visual": "none",
   "motion": "none",
   "duration": null,
   "reduced_motion": "none",
   "not_color_only": "n/a",
   "word": null,
   "reason": "limits are static config; shown only in hover detail"
  },
  {
   "signal": "l0:runtime.status",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "none",
   "visual": "none",
   "motion": "none",
   "duration": null,
   "reduced_motion": "none",
   "not_color_only": "n/a",
   "word": null,
   "reason": "status text is not meaningful to a lay viewer; hover detail only"
  },
  {
   "signal": "l0:source.closed",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "none",
   "visual": "none",
   "motion": "none",
   "duration": null,
   "reduced_motion": "none",
   "not_color_only": "n/a",
   "word": null,
   "reason": "end of a stream; the figure simply stops its activity marks"
  },
  {
   "signal": "l0:dependency.probe",
   "source": "l0-telemetry catalog",
   "emitted_by_ga_0_6": false,
   "target": "none",
   "visual": "none",
   "motion": "none",
   "duration": null,
   "reduced_motion": "none",
   "not_color_only": "n/a",
   "word": null,
   "reason": "environment probing has no meaning on the stage"
  },
  {
   "signal": "file:queue.added",
   "source": "file .ga/queue/<seq>-<id>.json appears",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "a tile appears on the waiting shelf (top band)",
   "motion": "tile drops in (base)",
   "duration": "base",
   "reduced_motion": "tile appears",
   "not_color_only": "tile shape + shelf position",
   "word": null,
   "hover": "item id, role, goal (first 80 chars)"
  },
  {
   "signal": "file:pool.live.claimed",
   "source": "file .ga/pool.json live[n].item",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "the tile flies from the shelf into the figure's hands",
   "motion": "flight (slow)",
   "duration": "slow",
   "reduced_motion": "tile moves instantly",
   "not_color_only": "position change + tile attached to figure",
   "word": "build"
  },
  {
   "signal": "file:queue.done",
   "source": "file moved to .ga/queue/done/",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "the tile settles on the done shelf (bottom band) and fills in",
   "motion": "settle (base)",
   "duration": "base",
   "reduced_motion": "tile placed, filled",
   "not_color_only": "filled tile + bottom shelf",
   "word": "done"
  },
  {
   "signal": "file:queue.failed",
   "source": "file moved to .ga/queue/failed/",
   "emitted_by_ga_0_6": true,
   "target": "tile",
   "visual": "the tile cracks and slides to the side shelf",
   "motion": "crack + slide",
   "duration": "base",
   "reduced_motion": "split tile on side shelf",
   "not_color_only": "split shape + side shelf",
   "word": null
  },
  {
   "signal": "file:pool.live.idle",
   "source": "file .ga/pool.json live[n].idle increases",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "figure dims and breathes slowly",
   "motion": "slow breathing (4 s)",
   "duration": "breath",
   "reduced_motion": "dimmed, halo held still",
   "not_color_only": "dimmed + smaller halo (size and lightness)",
   "word": "wait",
   "hover": "idle steps"
  },
  {
   "signal": "file:pool.live.retiring",
   "source": "file .ga/pool.json live[n].retiring",
   "emitted_by_ga_0_6": true,
   "target": "figure",
   "visual": "figure starts to fade toward the rim",
   "motion": "fade (slow)",
   "duration": "slow",
   "reduced_motion": "outline becomes thin",
   "not_color_only": "thin outline",
   "word": null,
   "hover": "outcome"
  },
  {
   "signal": "file:pool.round",
   "source": "file .ga/pool.json round increments",
