# 이름만 있다. 값은 .env 에 채우고 커밋하지 않는다.
POSTGRES_PASSWORD=
DATABASE_URL=
GC_JWT_SECRET=
GC_KEK_ID=
TELEMETRY_HASH_KEY=
GC_UPLOAD_DIR=
GC_UPLOAD_MAX_BYTES=
GC_CORS_ORIGIN=
